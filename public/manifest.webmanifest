{
  "name": "MacroSnap — photo macro tracking",
  "short_name": "MacroSnap",
  "description": "Photograph a meal to get its macros, log workouts to see the fuel you burned.",
  "start_url": "/today",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
