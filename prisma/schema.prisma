generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── AUTH ────────────────────────────────────────────────

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  name         String?
  passwordHash String?
  image        String?

  profile    Profile?
  foodLogs   FoodLog[]
  activities ActivityLog[]
  weights    WeightLog[]
  photos     MealPhoto[]
  savedFoods SavedFood[]
  accounts   Account[]
  sessions   Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── PROFILE & TARGETS ───────────────────────────────────

model Profile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  sex       BiologicalSex
  birthDate DateTime
  heightCm  Float
  weightKg  Float

  // Baseline movement EXCLUDING logged workouts — workouts are added on top
  // so they are never double counted.
  activityLevel ActivityLevel @default(LIGHTLY_ACTIVE)
  goal          Goal          @default(MAINTAIN)

  // Desired weight change per week in kg (negative = loss). Ignored for MAINTAIN.
  weeklyRateKg Float @default(0)

  // Snapshot of the numbers the targets were derived from.
  bmr  Float
  tdee Float

  targetMode TargetMode @default(AUTO)

  calorieTarget Float
  proteinTarget Float
  carbTarget    Float
  fatTarget     Float
  fiberTarget   Float

  // MyFitnessPal-style: exercise calories raise the day's eating target.
  addExerciseToTarget Boolean    @default(true)
  unitSystem          UnitSystem @default(METRIC)

  onboardedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

enum BiologicalSex {
  MALE
  FEMALE
}

enum ActivityLevel {
  SEDENTARY
  LIGHTLY_ACTIVE
  MODERATELY_ACTIVE
  VERY_ACTIVE
  EXTRA_ACTIVE
}

enum Goal {
  LOSE
  MAINTAIN
  GAIN
  RECOMP
}

enum TargetMode {
  AUTO
  MANUAL
}

enum UnitSystem {
  METRIC
  IMPERIAL
}

// ─── FOOD ────────────────────────────────────────────────

model MealPhoto {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  url       String
  mimeType  String
  sizeBytes Int

  status      PhotoStatus @default(PENDING)
  model       String?
  analysis    Json?
  errorReason String?     @db.Text

  logs FoodLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
}

enum PhotoStatus {
  PENDING
  ANALYZED
  FAILED
}

model FoodLog {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  photoId String?
  photo   MealPhoto? @relation(fields: [photoId], references: [id], onDelete: SetNull)

  // Local calendar day (UTC midnight) so day rollups never straddle timezones.
  loggedOn DateTime
  loggedAt DateTime @default(now())
  mealType MealType @default(SNACK)

  name  String
  brand String?

  quantity     Float  @default(1)
  unit         String @default("serving")
  servingLabel String?
  grams        Float?

  calories Float
  proteinG Float @default(0)
  carbsG   Float @default(0)
  fatG     Float @default(0)
  fiberG   Float @default(0)
  sugarG   Float @default(0)
  satFatG  Float @default(0)
  sodiumMg Float @default(0)

  source      EntrySource @default(MANUAL)
  confidence  Confidence?
  assumptions String?     @db.Text
  notes       String?     @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, loggedOn])
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

enum EntrySource {
  PHOTO
  MANUAL
  SAVED
  QUICK_ADD
}

enum Confidence {
  HIGH
  MEDIUM
  LOW
}

model SavedFood {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name String
  // Not nullable: Prisma cannot match NULL inside a compound unique, and the
  // upsert on (userId, name, brand) has to work for unbranded foods too.
  brand String @default("")

  // Macros are per one serving of `servingSize` `servingUnit`.
  servingSize  Float  @default(1)
  servingUnit  String @default("serving")
  servingLabel String?

  calories Float
  proteinG Float @default(0)
  carbsG   Float @default(0)
  fatG     Float @default(0)
  fiberG   Float @default(0)
  sugarG   Float @default(0)
  satFatG  Float @default(0)
  sodiumMg Float @default(0)

  isFavorite Boolean   @default(false)
  timesUsed  Int       @default(0)
  lastUsedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name, brand])
  @@index([userId, lastUsedAt])
}

// ─── ACTIVITY ────────────────────────────────────────────

model ActivityLog {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  performedOn DateTime
  performedAt DateTime @default(now())

  activityKey String
  name        String
  intensity   Intensity @default(MODERATE)
  durationMin Float
  met         Float

  distanceKm Float?
  steps      Int?

  // Total energy cost above nothing (gross kcal) for the session.
  caloriesBurned Float

  // Substrate split, derived from exercise intensity (RER model).
  carbsBurnedG   Float @default(0)
  fatBurnedG     Float @default(0)
  proteinBurnedG Float @default(0)

  notes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, performedOn])
}

enum Intensity {
  LIGHT
  MODERATE
  VIGOROUS
  MAX
}

// ─── BODY WEIGHT ─────────────────────────────────────────

model WeightLog {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  recordedOn DateTime
  weightKg   Float
  bodyFatPct Float?
  notes      String?

  createdAt DateTime @default(now())

  @@unique([userId, recordedOn])
  @@index([userId, recordedOn])
}
