# ---- Database ----------------------------------------------------------
# Any Postgres instance. Local default below matches `npm run db:migrate`.
DATABASE_URL="postgresql://macrosnap:macrosnap@localhost:5432/macrosnap?schema=public"

# ---- Auth --------------------------------------------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-to-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# ---- Claude (food photo analysis) --------------------------------------
# Without this the camera flow is disabled and the app falls back to manual
# entry. Get one at https://platform.claude.com/
ANTHROPIC_API_KEY=""

# Optional: override the model used for photo analysis.
# ANTHROPIC_MODEL="claude-opus-5"

# ---- Uploads -----------------------------------------------------------
# Where meal photos are written. Relative paths resolve from the repo root.
UPLOAD_DIR="./public/uploads"
